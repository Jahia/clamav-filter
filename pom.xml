<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.2.3.2</version>
    </parent>
    <groupId>org.jahia.community</groupId>
    <artifactId>clamav-filter</artifactId>
    <name>ClamAV filter</name>
    <version>1.0.5-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <description>Jahia module that scans uploaded files with a ClamAV daemon and blocks detected malware.</description>
    <properties>
        <yarn.arguments>build:production</yarn.arguments>
        <jahia-deploy-on-site>all</jahia-deploy-on-site>
        <jahia-module-type>system</jahia-module-type>
        <jahia-depends>default,graphql-dxm-provider</jahia-depends>
        <!-- Build and target Java 17 (Jahia 8.2 supports JDK 17). Required by the SonarQube
             scanner (sonar-maven-plugin needs a Java 17+ runtime). -->
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- SonarQube analysis scope so `mvn clean install sonar:sonar` works without -D flags. -->
        <sonar.projectKey>org.jahia.community:clamav-filter</sonar.projectKey>
        <sonar.sources>pom.xml,src/javascript,src/main</sonar.sources>
        <sonar.tests>src/test</sonar.tests>
        <!-- Build output and JS unit-test files are not production sources. index.js is the 4-line
             Module-Federation bootstrap entry (no business logic); it intentionally uses `window`
             (the Babel target includes Safari 12 / Chrome 60, which predate globalThis) and a
             promise-chained dynamic import (webpack topLevelAwait experiment is off), so the
             corresponding JS convention rules do not apply. -->
        <sonar.exclusions>src/main/resources/javascript/apps/**,**/*.test.jsx,**/*.test.js,src/javascript/index.js</sonar.exclusions>
    </properties>

    <scm>
        <connection>scm:git:git@github.com:Jahia/clamav-filter.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/clamav-filter.git</developerConnection>
        <url>https://github.com/Jahia/clamav-filter</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
            <version>${graphql-java.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.graphql-java-kickstart</groupId>
            <artifactId>graphql-java-servlet</artifactId>
            <version>${graphql-java-servlet.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.graphql-java</groupId>
            <artifactId>graphql-java-annotations</artifactId>
            <version>${graphql-java-annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>graphql-dxm-provider</artifactId>
            <version>3.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <!-- Pinned to the 5.x line on purpose. The jahia-modules 8.2.3.2 parent declares
                 maven-surefire-plugin 2.22.2, whose JUnitPlatformProvider needs JUnit Platform
                 1.x; junit-jupiter 6.x brings Platform 6, where
                 org.junit.platform.commons.util.PreconditionViolationException no longer exists,
                 so the forked test JVM dies with NoClassDefFoundError before any test runs.
                 (The previous 8.2.1.0 parent declared surefire 3.6.0-M1, which is why 6.1.3 was
                 fine there — note the surefire.plugin.version property says 2.22.2 in both and
                 is misleading; the build-section declaration is what applies.)
                 Revisit if the parent moves back to surefire 3.x. -->
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Test-only SLF4J binding: the module itself only depends on slf4j-api (transitively,
             provided scope) and relies on the OSGi container's own logging backend at runtime.
             No SLF4J provider is on the unit-test classpath otherwise, so LOGGER.error/.warn calls
             are silently swallowed by the NOP logger and can't be asserted on. logback-classic
             gives ClamavFilterDoFilterTest a real Logger implementation to attach a ListAppender
             to for the F5/F7 log-content assertions. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.6.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <!-- Keep the module on Java 17 against the jahia-modules 8.2.3.2 parent.
                 The parent sets <release>11</release> inside the default-compile and
                 default-testCompile *execution* configurations, and execution-level config
                 beats the maven.compiler.release/source/target properties above — so those
                 properties alone are silently ignored and compilation drops to -source 11
                 (which rejects the pattern-matching instanceof in ClamavFilter.sendError).
                 Overriding the same two execution ids is the only way to win. Only <release>
                 is restated: Maven merges plugin configuration per element, so the parent's
                 annotationProcessorPaths (Lombok) is inherited untouched.
                 NOTE: this makes the bundle Java 17 bytecode, so it requires a Jahia instance
                 running JDK 17 — it will not load on a JDK 11 one. Deliberate choice. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <release>${maven.compiler.release}</release>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <release>${maven.compiler.release}</release>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Pin Surefire 3.x. The jahia-modules 8.2.3.2 parent declares surefire 2.22.2
                 (2019), whose JUnit Platform provider is far too old to run this module's
                 JUnit 5 tests: it discovers ZERO tests and still reports BUILD SUCCESS — a
                 green build that verifies nothing, which is worse than a failure. The previous
                 8.2.1.0 parent declared surefire 3.6.0-M1, so 3.x is the norm here; only the
                 misleading surefire.plugin.version property says 2.22.2 in both.
                 Guard: `mvn test` must report 129 tests, never 0. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <executions>
                    <execution>
                        <id>npm install node and yarn</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-yarn</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v22.6.0</nodeVersion>
                            <yarnVersion>v1.22.21</yarnVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>yarn post-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                        <configuration>
                            <arguments>${yarn.arguments}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <_dsannotations>org.jahia.community.clamav.*</_dsannotations>
                        <!-- Keep the commons-fileupload import range as wide as the code actually
                             needs. bnd derives ranges from the BUILD classpath, and the
                             jahia-modules 8.2.3.2 parent brings commons-fileupload 1.6, which
                             narrowed this import to [1.6,2) — an OSGi resolution requirement that
                             would stop the bundle starting on any Jahia exporting an older 1.x
                             (1.0.4 shipped with [1.3,2)). The only API used here is
                             ServletFileUpload.isMultipartContent(), unchanged across 1.x, so the
                             narrowing was a build-classpath artifact rather than a real
                             requirement. Drop this line if the module is meant to require
                             Jahia 8.2.3+. -->
                        <Import-Package>org.apache.commons.fileupload.servlet;version="[1.3,2)",*</Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
